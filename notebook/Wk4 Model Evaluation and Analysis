      "source": [
        "# Define Dice and IoU Calculation\n",
        "def calculate_metrics(\n",
        "    predicted_logits,\n",
        "    true_masks,\n",
        "    threshold=0.5,\n",
        "    smooth=1e-6\n",
        "):\n",
        "    # Convert model logits into probabilities\n",
        "    probabilities = torch.sigmoid(\n",
        "        predicted_logits\n",
        "    )\n",
        "\n",
        "    # Convert probabilities into binary masks\n",
        "    predicted_masks = (\n",
        "        probabilities > threshold\n",
        "    ).float()\n",
        "\n",
        "    # Flatten each image into one long vector\n",
        "    predicted_flat = predicted_masks.view(\n",
        "        predicted_masks.size(0),\n",
        "        -1\n",
        "    )\n",
        "\n",
        "    true_flat = true_masks.view(\n",
        "        true_masks.size(0),\n",
        "        -1\n",
        "    )\n",
        "\n",
        "    # Pixels correctly predicted as calcium\n",
        "    intersection = (\n",
        "        predicted_flat * true_flat\n",
        "    ).sum(dim=1)\n",
        "\n",
        "    predicted_pixels = predicted_flat.sum(dim=1)\n",
        "    true_pixels = true_flat.sum(dim=1)\n",
        "\n",
        "    # Dice score\n",
        "    dice = (\n",
        "        2 * intersection + smooth\n",
        "    ) / (\n",
        "        predicted_pixels\n",
        "        + true_pixels\n",
        "        + smooth\n",
        "    )\n",
        "\n",
        "    # IoU score\n",
        "    union = (\n",
        "        predicted_pixels\n",
        "        + true_pixels\n",
        "        - intersection\n",
        "    )\n",
        "\n",
        "    iou = (\n",
        "        intersection + smooth\n",
        "    ) / (\n",
        "        union + smooth\n",
        "    )\n",
        "\n",
        "    return predicted_masks, dice, iou"
      ],
      "metadata": {
