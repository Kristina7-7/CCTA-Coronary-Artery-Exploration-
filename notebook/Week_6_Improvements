        "# Workflow diagram\n",
        "import os\n",
        "import matplotlib.pyplot as plt\n",
        "from matplotlib.patches import FancyBboxPatch\n",
        "\n",
        "# Make sure Week 6 folder exists\n",
        "coca_prepared = \"/content/drive/MyDrive/AI_Medical/COCA/coca_prepared\"\n",
        "\n",
        "week6_output = os.path.join(\n",
        "    coca_prepared,\n",
        "    \"week6_results\"\n",
        ")\n",
        "\n",
        "os.makedirs(week6_output, exist_ok=True)\n",
        "\n",
        "# Workflow steps\n",
        "steps = [\n",
        "    \"Raw COCA CT Images\",\n",
        "    \"Preprocessing\\nImages + Masks\",\n",
        "    \"Train / Validation / Test Split\",\n",
        "    \"Data Augmentation\\nFlip + Rotation\",\n",
        "    \"U-Net Training\",\n",
        "    \"Fine-Tuning\",\n",
        "    \"Predicted Segmentation Masks\",\n",
        "    \"Evaluation\\nDice + IoU\"\n",
        "]\n",
        "\n",
        "fig, ax = plt.subplots(figsize=(9, 12))\n",
        "\n",
        "ax.set_xlim(0, 10)\n",
        "ax.set_ylim(0, 18)\n",
        "ax.axis(\"off\")\n",
        "\n",
        "y_positions = list(range(16, 0, -2))\n",
        "\n",
        "for i, (step, y) in enumerate(zip(steps, y_positions)):\n",
        "\n",
        "    box = FancyBboxPatch(\n",
        "        (2, y - 0.55),\n",
        "        6,\n",
        "        1.1,\n",
        "        boxstyle=\"round,pad=0.03,rounding_size=0.08\",\n",
        "        linewidth=1.5,\n",
        "        fill=False\n",
        "    )\n",
        "\n",
        "    ax.add_patch(box)\n",
        "\n",
        "    ax.text(\n",
        "        5,\n",
        "        y,\n",
        "        step,\n",
        "        ha=\"center\",\n",
        "        va=\"center\",\n",
        "        fontsize=12\n",
        "    )\n",
        "\n",
        "    # Arrow to next box\n",
        "    if i < len(steps) - 1:\n",
        "        ax.annotate(\n",
        "            \"\",\n",
        "            xy=(5, y - 1.45),\n",
        "            xytext=(5, y - 0.65),\n",
        "            arrowprops=dict(\n",
        "                arrowstyle=\"->\",\n",
        "                linewidth=1.5\n",
        "            )\n",
        "        )\n",
        "\n",
        "ax.set_title(\n",
        "    \"COCA Coronary CT Segmentation Workflow\",\n",
        "    fontsize=16,\n",
        "    pad=20\n",
        ")\n",
        "\n",
        "workflow_path = os.path.join(\n",
        "    week6_output,\n",
        "    \"workflow_diagram.png\"\n",
        ")\n",
        "\n",
        "plt.savefig(\n",
        "    workflow_path,\n",
        "    dpi=300,\n",
        "    bbox_inches=\"tight\"\n",
        ")\n",
        "\n",
        "plt.show()\n",
        "\n",
        "print(\"Saved to:\")\n",
        "print(workflow_path)\n",
        "print(\"File exists:\", os.path.exists(workflow_path))"
