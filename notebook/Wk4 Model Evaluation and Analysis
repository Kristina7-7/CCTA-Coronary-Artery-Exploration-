        "# Function to visualize one prediction\n",
        "def visualize_prediction(row):\n",
        "\n",
        "    model.eval()\n",
        "\n",
        "    image = np.load(\n",
        "        os.path.join(images_dir, row[\"Filename\"])\n",
        "    ).astype(np.float32)\n",
        "\n",
        "    mask = np.load(\n",
        "        os.path.join(masks_dir, row[\"Filename\"])\n",
        "    ).astype(np.float32)\n",
        "\n",
        "    image = np.clip(image, -200, 1000)\n",
        "    image = (image + 200) / 1200\n",
        "\n",
        "    image_tensor = torch.from_numpy(image).float()\n",
        "    image_tensor = image_tensor.unsqueeze(0).unsqueeze(0)\n",
        "\n",
        "    image_tensor = F.interpolate(\n",
        "        image_tensor,\n",
        "        size=(256,256),\n",
        "        mode=\"bilinear\",\n",
        "        align_corners=False\n",
        "    ).to(device)\n",
        "\n",
        "    with torch.no_grad():\n",
        "        prediction = model(image_tensor)\n",
        "        prediction = torch.sigmoid(prediction)\n",
        "        prediction = (prediction > 0.5).float()\n",
        "\n",
        "    prediction = prediction.squeeze().cpu().numpy()\n",
        "\n",
        "    fig, axes = plt.subplots(1,3, figsize=(12,4))\n",
        "\n",
        "    axes[0].imshow(image, cmap=\"gray\")\n",
        "    axes[0].set_title(\"CT Image\")\n",
        "    axes[0].axis(\"off\")\n",
        "\n",
        "    axes[1].imshow(mask, cmap=\"gray\")\n",
        "    axes[1].set_title(\"Ground Truth\")\n",
        "    axes[1].axis(\"off\")\n",
        "\n",
        "    axes[2].imshow(prediction, cmap=\"gray\")\n",
        "    axes[2].set_title(\n",
        "        f\"Prediction\\nDice={row['Dice']:.3f}\"\n",
        "    )\n",
        "    axes[2].axis(\"off\")\n",
        "\n",
        "    plt.suptitle(row[\"Filename\"])\n",
        "\n",
        "    plt.tight_layout()\n",
        "\n",
        "    return fig"
      ],
